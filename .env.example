# ============================================================
# CyberSentinel — Environment Configuration Template
# SIH26-26145: AI-Based Threat Detection in Unidirectional Traffic
# ============================================================
# Copy this template to .env and configure for your deployment:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# NOTE: DO NOT commit your .env file containing local secrets.
# ============================================================

# ------------------------------------------------------------
# Environment & Server Settings
# ------------------------------------------------------------
# Deployment environment: 'development', 'staging', or 'production'
CYBERSENTINEL_ENV=development

# API host and port binding
CYBERSENTINEL_HOST=127.0.0.1
CYBERSENTINEL_PORT=8000

# Allowed CORS origins (comma-separated, or '*' for development)
CORS_ORIGINS=*

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------
# Path to the SQLite database file (created automatically if missing)
CYBERSENTINEL_DB_PATH=db/cybersentinel.db

# ------------------------------------------------------------
# Passive Sensor & Live Interface
# ------------------------------------------------------------
# Network interface for passive live sniffing (e.g., 'wlan0', 'eth0', 'Wi-Fi')
# Leave empty for automatic default gateway/adapter selection.
LIVE_INTERFACE=

# Aggregation window duration in seconds for flow feature extraction
DEFAULT_WINDOW_SECONDS=5

# Sensor telemetry destination endpoint
CYBERSENTINEL_BACKEND=http://127.0.0.1:8000

# ------------------------------------------------------------
# Passive Operation & Legal Compliance Constraints (NTRO / SIH)
# ------------------------------------------------------------
# MUST REMAIN 'true' FOR STRICT COMPLIANCE:
# - PASSIVE_ONLY: Prohibits packet generation, handshake initiation, or port probing
# - NO_PAYLOAD_DECRYPTION: Analyzes only unencrypted metadata; zero decryption
PASSIVE_ONLY=true
NO_PAYLOAD_DECRYPTION=true

# ------------------------------------------------------------
# Machine Learning & Detection Model Thresholds
# ------------------------------------------------------------
# Minimum confidence threshold (0.0 - 1.0) required to trigger high-priority alerts
DETECTOR_CONFIDENCE_THRESHOLD=0.50

# Maximum number of recent nodes returned in network digital twin graph
GRAPH_MAX_NODES=120
